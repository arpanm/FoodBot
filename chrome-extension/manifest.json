{
  "manifest_version": 3,
  "name": "FoodBot - AI Food Ordering Assistant",
  "version": "1.0.0",
  "description": "Automate food ordering on Swiggy and Zomato with Claude AI",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.swiggy.com/*",
    "https://www.zomato.com/*",
    "https://api.foodbot.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.swiggy.com/*",
        "https://www.zomato.com/*"
      ],
      "js": ["content-scripts/universal-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-polling": {
      "description": "Toggle job polling on/off",
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    },
    "force-poll": {
      "description": "Force poll for jobs immediately",
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      }
    }
  }
}
