# Security Package Environment Variables

# ============================================
# JWT Configuration
# ============================================
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT Access Token Secret (minimum 32 characters)
JWT_ACCESS_SECRET=your-secret-key-at-least-32-characters-long

# JWT Refresh Token Secret (minimum 32 characters)
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long

# JWT Token Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT Issuer and Audience
JWT_ISSUER=foodbot
JWT_AUDIENCE=foodbot-api

# ============================================
# Encryption Configuration
# ============================================
# Generate encryption key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters (32 bytes)

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# Redis Configuration (for Rate Limiting)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://foodbot.com

# ============================================
# Rate Limiting Configuration
# ============================================
# Default rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Default max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Account Lockout Configuration
# ============================================
# Maximum failed login attempts before lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ============================================
# AWS Secrets Manager (Production)
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Security Headers
# ============================================
# Enable security headers
ENABLE_HELMET=true

# Enable CORS
ENABLE_CORS=true

# ============================================
# Logging Configuration
# ============================================
# Enable security logging
ENABLE_SECURITY_LOGGING=true

# Log level (debug, info, warn, error)
LOG_LEVEL=info
