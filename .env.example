# ============================================
# SECURITY CONFIGURATION (CRITICAL - REQUIRED)
# ============================================
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT Configuration (minimum 32 characters each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=foodbot
JWT_AUDIENCE=foodbot-api

# Encryption Key (exactly 64 hexadecimal characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Account Lockout Configuration
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (Production: set to your frontend domains)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Security Features
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_SECURITY_LOGGING=true

# Application
PORT=3000
NODE_ENV=development

# LLM Providers
LLM_CLAUDE_ENABLED=true
LLM_OPENAI_ENABLED=true
LLM_GEMINI_ENABLED=true

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Database (FoodBot Application)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=foodbot
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# MCP (Multi-Channel Provider) Configuration
MCP_SWIGGY_ENABLED=true
MCP_ZOMATO_ENABLED=false
MCP_MOCK_ENABLED=true

# Google Places API Configuration
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
PROVIDER_STRATEGY=fallback

# Temporal Workflow Engine
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=foodbot-main-queue
TEMPORAL_UI_URL=http://localhost:8088
WORKER_MAX_CONCURRENT_ACTIVITIES=100
WORKER_MAX_CONCURRENT_WORKFLOWS=50

# Redis Configuration (Distributed Caching & Session Management)
# For local development without password: redis://localhost:6379
# For Docker with password: redis://:foodbot-redis-password@localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Graph Database
GRAPHDB_URL=bolt://localhost:7687

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=foodbot_restaurants

# Search Orchestrator Service
SEARCH_ORCHESTRATOR_URL=http://localhost:3002
SEARCH_ORCHESTRATOR_PORT=3002
MCP_ADAPTER_URL=http://localhost:8082/api/v1
DEFAULT_SEARCH_STRATEGY=comprehensive
ES_TIMEOUT_MS=200
MCP_TIMEOUT_MS=2000
DB_TIMEOUT_MS=500
MAX_TOTAL_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=300

# Apache Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8083

VECTOR_DB_PROVIDER=pinecone|weaviate
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# Claude Code Hooks Configuration
CLAUDE_FIX_ITERATION=0
CLAUDE_MAX_FIX_ITERATIONS=3

# Quality Gates
MIN_TEST_COVERAGE=80
MIN_READINESS_SCORE=0.85
SECURITY_BLOCK_ON_HIGH=true

# Observability & Monitoring
OBSERVABILITY_URL=http://localhost:8090/events

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1.0

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_ENABLED=true
METRICS_PREFIX=foodbot_
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# Health Checks
HEALTH_CHECK_TIMEOUT=5000
