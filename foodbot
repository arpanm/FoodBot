#!/usr/bin/env bash

###########################################
# FoodBot Project Manager
# A Maven wrapper-style script for managing
# the entire FoodBot project
###########################################

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Helper functions
print_header() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}========================================${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# Check if required tools are installed
check_requirements() {
    local missing=()

    if ! command -v node &> /dev/null; then
        missing+=("node")
    fi

    if ! command -v pnpm &> /dev/null; then
        missing+=("pnpm")
    fi

    if ! command -v docker &> /dev/null; then
        missing+=("docker")
    fi

    if ! command -v docker-compose &> /dev/null; then
        missing+=("docker-compose")
    fi

    if [ ${#missing[@]} -ne 0 ]; then
        print_error "Missing required tools: ${missing[*]}"
        echo ""
        echo "Please install the missing tools:"
        echo "  - Node.js: https://nodejs.org/"
        echo "  - pnpm: npm install -g pnpm"
        echo "  - Docker: https://docs.docker.com/get-docker/"
        echo "  - Docker Compose: https://docs.docker.com/compose/install/"
        exit 1
    fi
}

# Show help
show_help() {
    cat << EOF
FoodBot Project Manager - A comprehensive build and run tool

USAGE:
    ./foodbot [COMMAND] [OPTIONS]

COMMANDS:
    setup               Initial project setup (install dependencies, build all)
    install             Install all dependencies

    build               Build all projects
    build:ts            Build all TypeScript projects
    build:java          Build all Java projects
    build [PROJECT]     Build a specific project

    dev                 Run all projects in development mode
    dev [PROJECT]       Run a specific project in dev mode

    start               Start all services in production mode
    start [PROJECT]     Start a specific service
    stop                Stop all running services

    infra:up            Start infrastructure (Docker Compose)
    infra:down          Stop infrastructure
    infra:logs          Show infrastructure logs
    infra:ps            Show infrastructure status

    db:setup            Setup database with schema
    db:seed             Seed database with dummy data
    db:reset            Reset database (drop + setup + seed)
    db:migrate          Run database migrations

    test                Run all tests
    test:unit           Run unit tests for all projects
    test:integration    Run integration tests
    test:e2e            Run E2E tests
    test:coverage       Run tests with coverage report
    test [PROJECT]      Run tests for a specific project

    lint                Lint all projects
    lint [PROJECT]      Lint a specific project
    lint:fix            Lint and auto-fix all projects

    format              Check code formatting
    format:fix          Format all code

    typecheck           Run TypeScript type checking

    security            Run security audit
    security:fix        Fix security vulnerabilities

    quality             Run all quality checks (lint + format + typecheck)

    clean               Clean all build artifacts
    clean [PROJECT]     Clean a specific project

    logs [SERVICE]      Show logs for a service
    ps                  Show status of all services

    doctor              Check system requirements and project health

    # Production Commands
    health              Run production health checks
    monitor             Start real-time monitoring dashboard
    monitor:once        Show metrics once and exit
    deploy              Deploy to production
    deploy:rollback     Rollback to previous deployment
    benchmark           Run performance benchmarks
    benchmark:quick     Run quick benchmarks only
    logging:up          Start ELK logging stack
    logging:down        Stop ELK logging stack
    logging:logs        Show logging stack logs

PROJECTS:
    gateway-api         NestJS Gateway API
    customer-app        React Customer App
    restaurant-app      React Restaurant App
    mcp-adapter         TypeScript MCP Adapter
    mcp-orchestrator    Java MCP Orchestrator (Spring Boot)
    search-orchestrator TypeScript Search Orchestrator
    notification        Notification Service
    workflows           Temporal Workflows Package
    events              Kafka Events Package

EXAMPLES:
    ./foodbot setup                    # Initial setup
    ./foodbot infra:up                 # Start infrastructure
    ./foodbot db:setup                 # Setup database
    ./foodbot dev                      # Run all services in dev mode
    ./foodbot dev gateway-api          # Run only gateway-api in dev mode
    ./foodbot test:unit                # Run all unit tests
    ./foodbot test customer-app        # Run tests for customer-app
    ./foodbot build mcp-orchestrator   # Build Java MCP Orchestrator
    ./foodbot security                 # Run security audit
    ./foodbot quality                  # Run all quality checks

For more information, see docs/DEVELOPMENT_SETUP.md
EOF
}

# Project setup
do_setup() {
    print_header "FoodBot Initial Setup"

    check_requirements

    print_info "Installing dependencies..."
    pnpm install

    print_info "Building all projects..."
    pnpm build

    print_info "Setting up infrastructure..."
    docker-compose -f docker-compose.dev.yml up -d

    print_info "Waiting for infrastructure to be ready..."
    sleep 10

    print_info "Setting up database..."
    ./scripts/db-setup.sh

    print_success "Setup complete! Run './foodbot dev' to start development."
}

# Install dependencies
do_install() {
    print_header "Installing Dependencies"
    pnpm install

    # Install Java dependencies for MCP Orchestrator
    if [ -d "services/mcp-orchestrator" ]; then
        print_info "Installing Java dependencies..."
        (cd services/mcp-orchestrator && ./mvnw dependency:resolve)
    fi

    print_success "Dependencies installed"
}

# Build projects
do_build() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Building All Projects"
        pnpm build

        # Build Java projects
        if [ -d "services/mcp-orchestrator" ]; then
            print_info "Building MCP Orchestrator (Java)..."
            (cd services/mcp-orchestrator && ./mvnw clean package -DskipTests)
        fi

        print_success "All projects built successfully"
    else
        print_header "Building $project"

        case $project in
            mcp-orchestrator)
                (cd services/mcp-orchestrator && ./mvnw clean package -DskipTests)
                ;;
            *)
                pnpm --filter "@foodbot/$project" build
                ;;
        esac

        print_success "$project built successfully"
    fi
}

# Build TypeScript projects
do_build_ts() {
    print_header "Building TypeScript Projects"
    pnpm build
    print_success "TypeScript projects built"
}

# Build Java projects
do_build_java() {
    print_header "Building Java Projects"

    if [ -d "services/mcp-orchestrator" ]; then
        (cd services/mcp-orchestrator && ./mvnw clean package -DskipTests)
        print_success "Java projects built"
    else
        print_warning "No Java projects found"
    fi
}

# Run in development mode
do_dev() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Starting All Services (Dev Mode)"
        print_info "This will start all services concurrently..."
        print_info "Press Ctrl+C to stop all services"
        echo ""

        # Start infrastructure first
        docker-compose -f docker-compose.dev.yml up -d

        # Wait a bit for infrastructure
        sleep 5

        # Use pnpm to run all dev servers concurrently
        pnpm dev
    else
        print_header "Starting $project (Dev Mode)"

        case $project in
            mcp-orchestrator)
                (cd services/mcp-orchestrator && ./mvnw spring-boot:run)
                ;;
            *)
                pnpm --filter "@foodbot/$project" dev
                ;;
        esac
    fi
}

# Start services in production mode
do_start() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Starting All Services (Production Mode)"
        docker-compose up -d
        print_success "All services started"
        print_info "Run './foodbot logs' to view logs"
    else
        print_header "Starting $project (Production Mode)"
        docker-compose up -d "$project"
        print_success "$project started"
    fi
}

# Stop services
do_stop() {
    print_header "Stopping All Services"
    docker-compose down
    print_success "All services stopped"
}

# Infrastructure management
do_infra_up() {
    print_header "Starting Infrastructure"
    docker-compose -f docker-compose.dev.yml up -d postgres redis kafka zookeeper elasticsearch temporal temporal-ui
    print_success "Infrastructure started"
    print_info "Postgres: localhost:5432"
    print_info "Redis: localhost:6379"
    print_info "Kafka: localhost:9092"
    print_info "Elasticsearch: localhost:9200"
    print_info "Temporal UI: http://localhost:8080"
}

do_infra_down() {
    print_header "Stopping Infrastructure"
    docker-compose -f docker-compose.dev.yml down
    print_success "Infrastructure stopped"
}

do_infra_logs() {
    docker-compose -f docker-compose.dev.yml logs -f
}

do_infra_ps() {
    docker-compose -f docker-compose.dev.yml ps
}

# Database management
do_db_setup() {
    print_header "Setting Up Database"
    ./scripts/db-setup.sh
    print_success "Database setup complete"
}

do_db_seed() {
    print_header "Seeding Database"
    ./scripts/db-seed.sh
    print_success "Database seeded"
}

do_db_reset() {
    print_header "Resetting Database"
    ./scripts/db-reset.sh
    print_success "Database reset complete"
}

do_db_migrate() {
    print_header "Running Database Migrations"
    pnpm --filter "@foodbot/gateway-api" migration:run
    print_success "Migrations complete"
}

# Testing
do_test() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Running All Tests"
        pnpm test

        # Test Java projects
        if [ -d "services/mcp-orchestrator" ]; then
            (cd services/mcp-orchestrator && ./mvnw test)
        fi

        print_success "All tests passed"
    else
        print_header "Running Tests for $project"

        case $project in
            mcp-orchestrator)
                (cd services/mcp-orchestrator && ./mvnw test)
                ;;
            *)
                pnpm --filter "@foodbot/$project" test
                ;;
        esac

        print_success "Tests passed for $project"
    fi
}

do_test_unit() {
    print_header "Running Unit Tests"
    pnpm test:unit

    if [ -d "services/mcp-orchestrator" ]; then
        (cd services/mcp-orchestrator && ./mvnw test -Dtest.groups=unit)
    fi

    print_success "Unit tests passed"
}

do_test_integration() {
    print_header "Running Integration Tests"

    # Start infrastructure
    docker-compose -f docker-compose.dev.yml up -d
    sleep 10

    pnpm test:integration

    if [ -d "services/mcp-orchestrator" ]; then
        (cd services/mcp-orchestrator && ./mvnw test -Dtest.groups=integration)
    fi

    print_success "Integration tests passed"
}

do_test_e2e() {
    print_header "Running E2E Tests"

    # Start all services
    docker-compose -f docker-compose.dev.yml up -d
    sleep 15

    pnpm test:e2e

    print_success "E2E tests passed"
}

do_test_coverage() {
    print_header "Running Tests with Coverage"
    pnpm test:coverage

    if [ -d "services/mcp-orchestrator" ]; then
        (cd services/mcp-orchestrator && ./mvnw test jacoco:report)
    fi

    print_success "Coverage reports generated"
    print_info "TypeScript coverage: coverage/lcov-report/index.html"
    print_info "Java coverage: services/mcp-orchestrator/target/site/jacoco/index.html"
}

# Code quality
do_lint() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Linting All Projects"
        pnpm lint
        print_success "Linting complete"
    else
        print_header "Linting $project"
        pnpm --filter "@foodbot/$project" lint
        print_success "Linting complete for $project"
    fi
}

do_lint_fix() {
    print_header "Linting and Auto-fixing"
    pnpm lint:fix
    print_success "Auto-fix complete"
}

do_format() {
    print_header "Checking Code Formatting"
    pnpm format:check
    print_success "Format check complete"
}

do_format_fix() {
    print_header "Formatting Code"
    pnpm format
    print_success "Code formatted"
}

do_typecheck() {
    print_header "Running TypeScript Type Checking"
    pnpm typecheck
    print_success "Type checking complete"
}

do_security() {
    print_header "Running Security Audit"

    print_info "Auditing npm dependencies..."
    pnpm audit

    if [ -d "services/mcp-orchestrator" ]; then
        print_info "Auditing Maven dependencies..."
        (cd services/mcp-orchestrator && ./mvnw dependency-check:check)
    fi

    print_success "Security audit complete"
}

do_security_fix() {
    print_header "Fixing Security Vulnerabilities"
    pnpm audit --fix
    print_success "Security fixes applied"
}

do_quality() {
    print_header "Running All Quality Checks"

    print_info "1/4 Linting..."
    pnpm lint

    print_info "2/4 Format checking..."
    pnpm format:check

    print_info "3/4 Type checking..."
    pnpm typecheck

    print_info "4/4 Security audit..."
    pnpm audit

    print_success "All quality checks passed"
}

# Clean
do_clean() {
    local project=$1

    if [ -z "$project" ]; then
        print_header "Cleaning All Projects"

        print_info "Removing node_modules..."
        find . -name "node_modules" -type d -prune -exec rm -rf '{}' +

        print_info "Removing build artifacts..."
        find . -name "dist" -type d -prune -exec rm -rf '{}' +
        find . -name "build" -type d -prune -exec rm -rf '{}' +
        find . -name ".turbo" -type d -prune -exec rm -rf '{}' +
        find . -name "coverage" -type d -prune -exec rm -rf '{}' +

        if [ -d "services/mcp-orchestrator" ]; then
            print_info "Cleaning Java projects..."
            (cd services/mcp-orchestrator && ./mvnw clean)
        fi

        print_success "Cleanup complete"
    else
        print_header "Cleaning $project"

        case $project in
            mcp-orchestrator)
                (cd services/mcp-orchestrator && ./mvnw clean)
                ;;
            *)
                pnpm --filter "@foodbot/$project" clean || rm -rf "apps/$project/dist" "services/$project/dist"
                ;;
        esac

        print_success "$project cleaned"
    fi
}

# Logs
do_logs() {
    local service=$1

    if [ -z "$service" ]; then
        docker-compose logs -f
    else
        docker-compose logs -f "$service"
    fi
}

# Process status
do_ps() {
    print_header "Service Status"
    docker-compose ps
}

# System check
do_doctor() {
    print_header "FoodBot System Check"

    local all_good=true

    # Check Node.js
    if command -v node &> /dev/null; then
        local node_version=$(node --version)
        print_success "Node.js installed: $node_version"
    else
        print_error "Node.js not installed"
        all_good=false
    fi

    # Check pnpm
    if command -v pnpm &> /dev/null; then
        local pnpm_version=$(pnpm --version)
        print_success "pnpm installed: $pnpm_version"
    else
        print_error "pnpm not installed"
        all_good=false
    fi

    # Check Docker
    if command -v docker &> /dev/null; then
        local docker_version=$(docker --version)
        print_success "Docker installed: $docker_version"

        if docker ps &> /dev/null; then
            print_success "Docker daemon is running"
        else
            print_error "Docker daemon is not running"
            all_good=false
        fi
    else
        print_error "Docker not installed"
        all_good=false
    fi

    # Check Docker Compose
    if command -v docker-compose &> /dev/null; then
        local compose_version=$(docker-compose --version)
        print_success "Docker Compose installed: $compose_version"
    else
        print_error "Docker Compose not installed"
        all_good=false
    fi

    # Check Java (for MCP Orchestrator)
    if command -v java &> /dev/null; then
        local java_version=$(java -version 2>&1 | head -n 1)
        print_success "Java installed: $java_version"
    else
        print_warning "Java not installed (optional, only needed for MCP Orchestrator)"
    fi

    # Check Maven
    if [ -f "services/mcp-orchestrator/mvnw" ]; then
        print_success "Maven wrapper found"
    else
        print_warning "Maven wrapper not found (optional)"
    fi

    # Check infrastructure
    print_info ""
    print_info "Checking infrastructure services..."

    if docker-compose -f docker-compose.dev.yml ps postgres | grep -q "Up"; then
        print_success "PostgreSQL is running"
    else
        print_warning "PostgreSQL is not running (run './foodbot infra:up')"
    fi

    if docker-compose -f docker-compose.dev.yml ps redis | grep -q "Up"; then
        print_success "Redis is running"
    else
        print_warning "Redis is not running (run './foodbot infra:up')"
    fi

    # Check project files
    print_info ""
    print_info "Checking project structure..."

    if [ -f "package.json" ]; then
        print_success "package.json found"
    else
        print_error "package.json not found"
        all_good=false
    fi

    if [ -f "pnpm-workspace.yaml" ]; then
        print_success "pnpm workspace configured"
    else
        print_error "pnpm-workspace.yaml not found"
        all_good=false
    fi

    if [ -f "docker-compose.yml" ]; then
        print_success "docker-compose.yml found"
    else
        print_error "docker-compose.yml not found"
        all_good=false
    fi

    # Overall status
    echo ""
    if [ "$all_good" = true ]; then
        print_success "System check passed! Your environment is ready."
    else
        print_error "System check failed. Please fix the issues above."
        exit 1
    fi
}

# Production health check
do_health() {
    print_header "Running Production Health Check"
    ./scripts/health-check.sh
}

# Real-time monitoring
do_monitor() {
    print_header "Starting Real-time Monitoring"
    ./scripts/monitor.sh
}

# Show metrics once
do_monitor_once() {
    print_header "Production Metrics"
    ./scripts/monitor.sh once
}

# Production deployment
do_deploy() {
    print_header "Deploying to Production"
    ./scripts/production-deploy.sh
}

# Rollback deployment
do_deploy_rollback() {
    print_header "Rolling Back Deployment"
    ./scripts/production-deploy.sh rollback
}

# Performance benchmarks
do_benchmark() {
    print_header "Running Performance Benchmarks"
    cd performance
    ./benchmark.sh --full
}

# Quick benchmarks
do_benchmark_quick() {
    print_header "Running Quick Benchmarks"
    cd performance
    ./benchmark.sh --quick
}

# Start logging stack
do_logging_up() {
    print_header "Starting ELK Logging Stack"
    docker-compose -f docker-compose.logging.yml up -d
    print_success "Logging stack started"
    print_info "Access Kibana at: http://localhost:5601"
    print_info "Access Elasticsearch at: http://localhost:9200"
}

# Stop logging stack
do_logging_down() {
    print_header "Stopping ELK Logging Stack"
    docker-compose -f docker-compose.logging.yml down
    print_success "Logging stack stopped"
}

# Show logging stack logs
do_logging_logs() {
    docker-compose -f docker-compose.logging.yml logs -f
}

# Main command router
main() {
    local command=$1
    shift || true

    case $command in
        setup)
            do_setup
            ;;
        install)
            do_install
            ;;
        build)
            do_build "$@"
            ;;
        build:ts)
            do_build_ts
            ;;
        build:java)
            do_build_java
            ;;
        dev)
            do_dev "$@"
            ;;
        start)
            do_start "$@"
            ;;
        stop)
            do_stop
            ;;
        infra:up)
            do_infra_up
            ;;
        infra:down)
            do_infra_down
            ;;
        infra:logs)
            do_infra_logs
            ;;
        infra:ps)
            do_infra_ps
            ;;
        db:setup)
            do_db_setup
            ;;
        db:seed)
            do_db_seed
            ;;
        db:reset)
            do_db_reset
            ;;
        db:migrate)
            do_db_migrate
            ;;
        test)
            do_test "$@"
            ;;
        test:unit)
            do_test_unit
            ;;
        test:integration)
            do_test_integration
            ;;
        test:e2e)
            do_test_e2e
            ;;
        test:coverage)
            do_test_coverage
            ;;
        lint)
            do_lint "$@"
            ;;
        lint:fix)
            do_lint_fix
            ;;
        format)
            do_format
            ;;
        format:fix)
            do_format_fix
            ;;
        typecheck)
            do_typecheck
            ;;
        security)
            do_security
            ;;
        security:fix)
            do_security_fix
            ;;
        quality)
            do_quality
            ;;
        clean)
            do_clean "$@"
            ;;
        logs)
            do_logs "$@"
            ;;
        ps)
            do_ps
            ;;
        doctor)
            do_doctor
            ;;
        health)
            do_health
            ;;
        monitor)
            do_monitor
            ;;
        monitor:once)
            do_monitor_once
            ;;
        deploy)
            do_deploy
            ;;
        deploy:rollback)
            do_deploy_rollback
            ;;
        benchmark)
            do_benchmark
            ;;
        benchmark:quick)
            do_benchmark_quick
            ;;
        logging:up)
            do_logging_up
            ;;
        logging:down)
            do_logging_down
            ;;
        logging:logs)
            do_logging_logs
            ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
