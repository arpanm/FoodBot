# Claude Code Ignore Patterns
# Files and directories to exclude from Claude's context

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/

# Coverage and reports
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Caches
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.pnpm-store/

# Editor directories and files
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment files (sensitive)
.env
.env.local
.env.*.local
secrets.yaml
secrets.json

# Git internals
.git/
.gitignore

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.temp
.tmp/

# Lock files (too large)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Generated documentation
docs/api/
docs/coverage/

# Test fixtures (unless needed)
**/__fixtures__/*
**/__mocks__/*
**/fixtures/*.bin
**/fixtures/*.dump

# Large binary files
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.webm
*.wav
*.mp3
*.pdf
*.zip
*.tar
*.gz
*.rar

# Docker artifacts
.dockerignore
*.dockerfile

# Infrastructure (managed separately)
terraform/.terraform/
*.tfstate
*.tfstate.*

# Generated code (can be regenerated)
**/*.generated.ts
**/*.generated.js
**/generated/**

# Vendored code
vendor/
third_party/

# OS files
.Spotlight-V100
.Trashes
._*
$RECYCLE.BIN/

# IDE-specific
*.iml
*.ipr
*.iws
.project
.classpath
.c9/
*.launch
.settings/

# TypeScript
*.tsbuildinfo

# Optional REPL history
.node_repl_history

# Storybook
storybook-static/

# Cypress
cypress/videos/
cypress/screenshots/

# Misc
.vercel
.netlify
.serverless/
.fusebox/
.dynamodb/
.tern-port
.vscode-test
.vite-inspect/

# Project-specific exclusions
# (Add project-specific patterns below)

# Don't load hook execution artifacts
.claude/debug.log
.claude/notifications.log
.tmp_*

# Exclude large data files
**/data/*.csv
**/data/*.json
