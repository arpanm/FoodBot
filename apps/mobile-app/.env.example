# FoodBot Mobile App - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# API Configuration
# ============================================================================

# Gateway API URL (backend API)
# Development: http://localhost:3000/api/v1
# Production: https://api.foodbot.com/api/v1
GATEWAY_API_URL=http://localhost:3000/api/v1

# ============================================================================
# OAuth Configuration
# ============================================================================

# Google OAuth
# Get credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook OAuth
# Get credentials at: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your_facebook_app_id_here

# Apple Sign In
# Get credentials at: https://developer.apple.com/
APPLE_CLIENT_ID=your_apple_service_id_here

# ============================================================================
# Deep Linking
# ============================================================================

# OAuth redirect URI (must match app scheme)
OAUTH_REDIRECT_URI=foodbot://oauth/callback

# ============================================================================
# Feature Flags (optional)
# ============================================================================

# Enable debug logging
DEBUG_MODE=true

# Enable analytics
ENABLE_ANALYTICS=false

# Enable crash reporting
ENABLE_CRASH_REPORTING=false

# ============================================================================
# Third-Party Services (optional)
# ============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Firebase project ID
FIREBASE_PROJECT_ID=

# Google Maps API key
GOOGLE_MAPS_API_KEY=
