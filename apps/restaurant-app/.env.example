# FoodBot Restaurant App Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws

# Authentication
VITE_JWT_STORAGE_KEY=restaurant_auth_token
VITE_REFRESH_TOKEN_KEY=restaurant_refresh_token

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_SOUND_ALERTS=true

# Stripe Connect (for payment settings)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
