{
"name": "foodbot",
"version": "1.0.0",
"private": true,
"description": "Agentic Restaurant Commerce Platform — AI Orchestrated SDLC + Runtime",
"license": "UNLICENSED",

"scripts": {
"bootstrap": "pnpm install",

"lint": "eslint . --ext .js,.ts",
"format": "prettier --write .",

"build": "echo 'No global build. Services build independently.'",

"test": "echo 'Tests executed per-service'",

"tool:apply-patch": "node tools/repo-writer/applyPatch.js",
"tool:start-workflow": "node tools/temporal/startWorkflow.js",
"tool:emit-event": "node tools/observability/emitEvent.js",

"ai:validate": "node tools/utils/validateAiConfig.js || echo 'validation stub'",

"prepare": "echo 'Environment ready'"

},

"dependencies": {
"axios": "^1.7.7",
"dotenv": "^16.4.5",
"uuid": "^9.0.1",
"pino": "^9.4.0",
"ajv": "^8.17.1",
"zod": "^3.23.8",
"simple-git": "^3.25.0"
},

"devDependencies": {
"eslint": "^9.9.0",
"prettier": "^3.3.3"
},

"engines": {
"node": ">=20"
}
}
