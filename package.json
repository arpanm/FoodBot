{
  "name": "foodbot",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Agentic Restaurant Commerce Platform — AI Orchestrated SDLC + Runtime",
  "license": "UNLICENSED",
  "scripts": {
    "bootstrap": "pnpm install",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "echo 'No global build. Services build independently.'",
    "clean": "rm -rf dist build coverage .next .turbo node_modules/.cache",
    "test": "jest --selectProjects=unit --passWithNoTests",
    "test:unit": "jest --selectProjects=unit --passWithNoTests",
    "test:integration": "jest --selectProjects=integration --passWithNoTests",
    "test:watch": "jest --watch --selectProjects=unit",
    "test:coverage": "jest --coverage --selectProjects=unit --selectProjects=integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "quality:check": "pnpm lint && pnpm format:check && pnpm test:coverage",
    "quality:fix": "pnpm lint:fix && pnpm format",
    "security:scan": "snyk test",
    "security:monitor": "snyk monitor",
    "security:fix": "snyk fix",
    "sonar": "sonar-scanner",
    "sonar:local": "sonar-scanner -Dsonar.host.url=http://localhost:9000",
    "tool:apply-patch": "node tools/repo-writer/applyPatch.js",
    "tool:start-workflow": "node tools/temporal/startWorkflow.js",
    "tool:emit-event": "node tools/observability/emitEvent.js",
    "tool:validate-workflow": "node tools/utils/validateWorkflow.js",
    "ai:validate": "node tools/utils/validateAiConfig.js || echo 'validation stub'",
    "hooks:verify": ".claude/verify-hooks.sh",
    "prepare": "echo 'Environment ready'",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "docker:health": "./scripts/docker-health-check.sh",
    "docker:clean": "docker-compose down -v",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^16.4.5",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-git": "^3.25.0",
    "typeorm": "^0.3.28",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/testing": "^11.1.13",
    "@playwright/test": "^1.48.0",
    "@temporalio/nyc-test-coverage": "^1.11.3",
    "@temporalio/testing": "^1.11.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.4.2",
    "snyk": "^1.1293.1",
    "sonarqube-scanner": "^4.2.6",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=20"
  }
}
