[Unit]
Description=FoodBot Frontend (React)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/foodbot/current/frontend
ExecStart=/usr/bin/npx serve -s . -l 3001
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
